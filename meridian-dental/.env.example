# Application
APP_NAME=Meridian Dental
APP_ENV=development
DEBUG=true

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Database
DATABASE_URL=postgresql+asyncpg://meridian:meridian_secret@db:5432/meridian_dental
DATABASE_URL_SYNC=postgresql://meridian:meridian_secret@db:5432/meridian_dental
POSTGRES_USER=meridian
POSTGRES_PASSWORD=meridian_secret
POSTGRES_DB=meridian_dental

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# MinIO / S3 Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET_NAME=meridian-dental
S3_REGION=us-east-1

# Email (future)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Default Clinic
DEFAULT_CLINIC_NAME=Meridian Dental
DEFAULT_CLINIC_PHONE=+91-9876543210
DEFAULT_CLINIC_EMAIL=info@meridian.dental
DEFAULT_CLINIC_ADDRESS=123 Dental Street, Chennai, Tamil Nadu 600001
